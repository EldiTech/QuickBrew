<?xml version="1.0" encoding="utf-8"?>
<!--
  The cup mark, authored on the same geometry as CupMark in
  lib/widgets/cup_mark.dart, mapped onto the 108x108 adaptive-icon canvas and
  held inside the 72dp safe circle so no mask clips it.

  Two deliberate differences from the in-app mark: the cup is filled sage (the
  landed state, not the outline) and the stroke is 4 rather than 1.75, because a
  1.1-unit hairline disappears at 48dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Body: tapered, rounded base, closed across the rim. -->
    <path
        android:fillColor="#588157"
        android:strokeColor="#E8DCC4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M28,33.07 L33.94,69.92 Q34.75,74.92 39.81,74.92 L52.64,74.92 Q57.7,74.92 58.51,69.92 L64.45,33.07 Z" />

    <!-- Handle: stroked only, so it never takes the fill. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#E8DCC4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M63.1,41.85 C79.98,42.52 78.63,60.07 60.4,60.07" />
</vector>
